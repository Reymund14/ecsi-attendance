# Local development defaults for the Vite build.
#
# Vite replaces %VITE_*% placeholders in index.html at BUILD time.
# On Vercel these are overridden by the environment variables you set in
# Project Settings -> Environment Variables (production + preview).
#
# Committed on purpose so `npm run build` works with zero configuration locally.
# Never put secrets here — everything with a VITE_ prefix is public in the bundle.

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_WS_URL=ws://127.0.0.1:8000/ws/dashboard