# ─────────────────────────────────────────────────────────────────────────────
# Production environment template — TEMPLATE ONLY, safe to commit.
#
# Local dev:  cp .env.production .env   (then edit for your machine)
# Render:     paste these into the service's Environment tab, one KEY=value
#             per line. You do NOT copy the file onto the server.
#
# NEVER commit a filled-in copy of this file. It is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Force production guards (secret length + PostgreSQL requirement).
ENVIRONMENT=production
DEBUG=false

# REQUIRED in production, min 32 chars. Generate a fresh one per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# Supabase transaction pooler (port 5432), URI mode, password URL-encoded.
# Also append ?sslmode=require if your network needs it.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Object storage (REQUIRED in production) ───────────────────────────────────
# Render's filesystem is ephemeral, so profile photos and audit captures would
# vanish on every redeploy unless they live in Supabase Storage.
#
# With both values below set, STORAGE_BACKEND can stay "auto" and resolves to
# supabase. Setting STORAGE_BACKEND=supabase explicitly is also fine, but it
# then REQUIRES both credentials or the app refuses to start.
#
# Where to find these: Supabase -> Project Settings -> API
#   Project URL            -> SUPABASE_URL
#   service_role  (secret) -> SUPABASE_SERVICE_ROLE_KEY
#
# SECURITY: the service role key bypasses all row-level security. It lives only
# in the backend's environment. Never prefix it with VITE_ and never commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_paste_the_service_role_key_here

# "auto" (default) | "local" | "supabase"
STORAGE_BACKEND=auto

# Bucket names. profile-photos is served PUBLICLY (avatars are embedded in
# <img> tags); audit-captures is PRIVATE and only reachable through the
# short-lived signed URLs minted by the admin capture endpoints.
SUPABASE_BUCKET_PHOTOS=profile-photos
SUPABASE_BUCKET_CAPTURES=audit-captures

# Lifetime of a signed capture URL, in seconds (default 900 = 15 min).
SIGNED_URL_TTL_SECONDS=900

# Let the app create missing buckets at startup (idempotent). Set false if you
# provision buckets yourself and want zero write calls at boot.
STORAGE_AUTO_CREATE_BUCKETS=true

# Vercel frontend origin(s). JSON array OR comma-separated both work.
ALLOWED_ORIGINS=["https://YOUR-APP.vercel.app"]

# Allows any Vercel preview subdomain without listing each one.
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$

# Token lifetime. 480 min = 8h (a normal shift).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Local filesystem paths (development / local mode only) ────────────────────
# Ignored when the resolved backend is "supabase". EPHEMERAL on Render unless
# you mount a persistent disk.
AUDIT_CAPTURE_DIR=./audit_captures
PROFILE_PHOTO_DIR=./static/profiles

# ── Connection pool (small on purpose: Supabase multiplexes via pgbouncer) ────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
